+bool SDL_GetGamepadButton(SDL_Gamepad *gamepad, SDL_GamepadButton button)
+{
+	const int index = gamepad ? Switch2_PadIndex(gamepad->id) : -1;
+	u64 held;
+	u64 mask = 0;
+
+	if ((index < 0) || !s_padConnected[index])
+	{
+		return false;
+	}
+	held = padGetButtons(&s_pads[index]);
+
+	// SDL's buttons are positional: SOUTH is the bottom face button (B on a
+	// Nintendo pad), which the game maps to the PlayStation's Cross.
+	switch (button)
+	{
+	case SDL_GAMEPAD_BUTTON_SOUTH: mask = HidNpadButton_B; break;
+	case SDL_GAMEPAD_BUTTON_EAST: mask = HidNpadButton_A; break;
+	case SDL_GAMEPAD_BUTTON_WEST: mask = HidNpadButton_Y; break;
+	case SDL_GAMEPAD_BUTTON_NORTH: mask = HidNpadButton_X; break;
+	case SDL_GAMEPAD_BUTTON_BACK: mask = HidNpadButton_Minus; break;
+	case SDL_GAMEPAD_BUTTON_START: mask = HidNpadButton_Plus; break;
+	case SDL_GAMEPAD_BUTTON_LEFT_STICK: mask = HidNpadButton_StickL; break;
+	case SDL_GAMEPAD_BUTTON_RIGHT_STICK: mask = HidNpadButton_StickR; break;
+	case SDL_GAMEPAD_BUTTON_LEFT_SHOULDER: mask = HidNpadButton_L; break;
+	case SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER: mask = HidNpadButton_R; break;
+	case SDL_GAMEPAD_BUTTON_DPAD_UP: mask = HidNpadButton_Up; break;
+	case SDL_GAMEPAD_BUTTON_DPAD_DOWN: mask = HidNpadButton_Down; break;
+	case SDL_GAMEPAD_BUTTON_DPAD_LEFT: mask = HidNpadButton_Left; break;
+	case SDL_GAMEPAD_BUTTON_DPAD_RIGHT: mask = HidNpadButton_Right; break;
+	default: return false;
+	}
+	return (held & mask) != 0;
+}
+
+Sint16 SDL_GetGamepadAxis(SDL_Gamepad *gamepad, SDL_GamepadAxis axis)
+{
+	const int index = gamepad ? Switch2_PadIndex(gamepad->id) : -1;
+	HidAnalogStickState stick;
+	int value;
+
+	if ((index < 0) || !s_padConnected[index])
+	{
+		return 0;
+	}
+
+	switch (axis)
+	{
+	case SDL_GAMEPAD_AXIS_LEFTX:
+	case SDL_GAMEPAD_AXIS_LEFTY:
+	case SDL_GAMEPAD_AXIS_RIGHTX:
+	case SDL_GAMEPAD_AXIS_RIGHTY:
+		stick = padGetStickPos(&s_pads[index], (axis == SDL_GAMEPAD_AXIS_LEFTX || axis == SDL_GAMEPAD_AXIS_LEFTY) ? 0 : 1);
+		// libnx reports up as positive; SDL reports down as positive.
+		value = (axis == SDL_GAMEPAD_AXIS_LEFTX || axis == SDL_GAMEPAD_AXIS_RIGHTX) ? stick.x : -stick.y;
+		if (value > 32767)
+		{
+			value = 32767;
+		}
+		if (value < -32768)
+		{
+			value = -32768;
+		}
+		return (Sint16)value;
+	case SDL_GAMEPAD_AXIS_LEFT_TRIGGER:
+		return (padGetButtons(&s_pads[index]) & HidNpadButton_ZL) ? 32767 : 0;
+	case SDL_GAMEPAD_AXIS_RIGHT_TRIGGER:
+		return (padGetButtons(&s_pads[index]) & HidNpadButton_ZR) ? 32767 : 0;
+	default:
+		return 0;
+	}
+}
+
+static bool Switch2_PrepareVibration(int index)
+{
+	HidNpadIdType id;
+	HidNpadStyleTag style;
+	u32 styleSet;
+
+	if (s_vibrationReady[index])
+	{
+		return true;
+	}
+	styleSet = padGetStyleSet(&s_pads[index]);
+	if ((index == 0) && (styleSet & HidNpadStyleTag_NpadHandheld))
+	{
+		id = HidNpadIdType_Handheld;
+		style = HidNpadStyleTag_NpadHandheld;
+	}
+	else
+	{
+		id = (HidNpadIdType)(HidNpadIdType_No1 + index);
+		if (styleSet & HidNpadStyleTag_NpadFullKey)
+		{
+			style = HidNpadStyleTag_NpadFullKey;
+		}
+		else
+		{
+			style = HidNpadStyleTag_NpadJoyDual;
+		}
+	}
+	if (R_FAILED(hidInitializeVibrationDevices(s_vibration[index], 2, id, style)))
+	{
+		return false;
+	}
+	s_vibrationReady[index] = true;
+	return true;
+}
+
+bool SDL_RumbleGamepad(SDL_Gamepad *gamepad, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble, Uint32 duration_ms)
+{
+	const int index = gamepad ? Switch2_PadIndex(gamepad->id) : -1;
+	HidVibrationValue values[2];
+	float low = (float)low_frequency_rumble / 65535.0f;
+	float high = (float)high_frequency_rumble / 65535.0f;
+
+	(void)duration_ms; // the game sends a new value (or zero) every frame
+	if ((index < 0) || !s_padConnected[index] || !Switch2_PrepareVibration(index))
+	{
+		return false;
+	}
+	for (int i = 0; i < 2; i++)
+	{
+		values[i].amp_low = low;
+		values[i].freq_low = 160.0f;
+		values[i].amp_high = high;
+		values[i].freq_high = 320.0f;
+	}
+	return R_SUCCEEDED(hidSendVibrationValues(s_vibration[index], values, 2));
+}
