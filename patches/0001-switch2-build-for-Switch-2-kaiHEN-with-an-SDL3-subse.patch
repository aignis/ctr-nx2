+// ---------------------------------------------------------------------------
+// C library gaps in newlib for this target
+
+#include <time.h>
+
+int timespec_get(struct timespec *ts, int base)
+{
+	if ((ts == NULL) || (base != TIME_UTC) || (clock_gettime(CLOCK_REALTIME, ts) != 0))
+	{
+		return 0;
+	}
+	return base;
+}
