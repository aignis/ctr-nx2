+// ---------------------------------------------------------------------------
+// Gamepads: libnx pad. Joystick IDs 1..4 are players 1..4.
+
+#define SWITCH2_MAX_PADS 4
+
+struct SDL_Gamepad
+{
+	SDL_JoystickID id;
+};
+
+static bool s_padInitialized;
+static PadState s_pads[SWITCH2_MAX_PADS];
+static bool s_padConnected[SWITCH2_MAX_PADS];
+static struct SDL_Gamepad s_gamepads[SWITCH2_MAX_PADS];
+static HidVibrationDeviceHandle s_vibration[SWITCH2_MAX_PADS][2];
+static bool s_vibrationReady[SWITCH2_MAX_PADS];
+
+static void Switch2_PadInit(void)
+{
+	if (s_padInitialized)
+	{
+		return;
+	}
+	s_padInitialized = true;
+	padConfigureInput(SWITCH2_MAX_PADS, HidNpadStyleSet_NpadStandard);
+	padInitialize(&s_pads[0], HidNpadIdType_No1, HidNpadIdType_Handheld);
+	padInitialize(&s_pads[1], HidNpadIdType_No2);
+	padInitialize(&s_pads[2], HidNpadIdType_No3);
+	padInitialize(&s_pads[3], HidNpadIdType_No4);
+	for (int i = 0; i < SWITCH2_MAX_PADS; i++)
+	{
+		s_gamepads[i].id = (SDL_JoystickID)(i + 1);
+		padUpdate(&s_pads[i]);
+		s_padConnected[i] = padIsConnected(&s_pads[i]);
+	}
+}
+
+static void Switch2_PadUpdate(void)
+{
+	if (!s_padInitialized)
+	{
+		return;
+	}
+	for (int i = 0; i < SWITCH2_MAX_PADS; i++)
+	{
+		bool connected;
+		padUpdate(&s_pads[i]);
+		connected = padIsConnected(&s_pads[i]);
+		if (connected != s_padConnected[i])
+		{
+			SDL_Event event;
+			memset(&event, 0, sizeof(event));
+			event.type = connected ? SDL_EVENT_GAMEPAD_ADDED : SDL_EVENT_GAMEPAD_REMOVED;
+			event.gdevice.which = (SDL_JoystickID)(i + 1);
+			s_padConnected[i] = connected;
+			s_vibrationReady[i] = false;
+			Switch2_PushEvent(&event);
+		}
+	}
+}
+
+static int Switch2_PadIndex(SDL_JoystickID id)
+{
+	return ((id >= 1) && (id <= SWITCH2_MAX_PADS)) ? (int)id - 1 : -1;
+}
+
+void SDL_UpdateJoysticks(void)
+{
+	Switch2_PadUpdate();
+}
