+bool SDL_GetAudioDeviceFormat(SDL_AudioDeviceID devid, SDL_AudioSpec *spec, int *sample_frames)
+{
+	(void)devid;
+	if (spec)
+	{
+		spec->format = SDL_AUDIO_S16;
+		spec->channels = 2;
+		spec->freq = 48000;
+	}
+	if (sample_frames)
+	{
+		*sample_frames = SWITCH2_AUDIO_BUFFER_FRAMES;
+	}
+	return true;
+}
+
+bool SDL_GetAudioStreamFormat(SDL_AudioStream *stream, SDL_AudioSpec *src_spec, SDL_AudioSpec *dst_spec)
+{
+	if (stream == NULL)
+	{
+		return SDL_SetError("no stream");
+	}
+	if (src_spec)
+	{
+		*src_spec = stream->spec;
+	}
+	if (dst_spec)
+	{
+		*dst_spec = stream->spec; // audren resamples the voice to 48 kHz
+	}
+	return true;
+}
