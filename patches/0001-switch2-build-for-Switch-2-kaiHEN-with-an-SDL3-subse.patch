+bool SDL_LockAudioStream(SDL_AudioStream *stream)
+{
+	if (stream == NULL)
+	{
+		return false;
+	}
+	rmutexLock(&stream->lock);
+	return true;
+}
+
+bool SDL_UnlockAudioStream(SDL_AudioStream *stream)
+{
+	if (stream == NULL)
+	{
+		return false;
+	}
+	rmutexUnlock(&stream->lock);
+	return true;
+}
+
+bool SDL_PutAudioStreamData(SDL_AudioStream *stream, const void *buf, int len)
+{
+	const u8 *src = (const u8 *)buf;
+	bool ok = true;
+	if ((stream == NULL) || (buf == NULL) || (len < 0))
+	{
+		return SDL_SetError("invalid audio data");
+	}
+	rmutexLock(&stream->lock);
+	if (len > SWITCH2_AUDIO_QUEUE_BYTES - stream->queueBytes)
+	{
+		ok = SDL_SetError("audio queue full");
+	}
+	else
+	{
+		int tail = (stream->queueHead + stream->queueBytes) % SWITCH2_AUDIO_QUEUE_BYTES;
+		int remaining = len;
+		while (remaining > 0)
+		{
+			int chunk = SWITCH2_AUDIO_QUEUE_BYTES - tail;
+			if (chunk > remaining)
+			{
+				chunk = remaining;
+			}
+			memcpy(stream->queue + tail, src, (size_t)chunk);
+			src += chunk;
+			remaining -= chunk;
+			tail = (tail + chunk) % SWITCH2_AUDIO_QUEUE_BYTES;
+		}
+		stream->queueBytes += len;
+	}
+	rmutexUnlock(&stream->lock);
+	return ok;
+}
+
+int SDL_GetAudioStreamQueued(SDL_AudioStream *stream)
+{
+	int queued;
+	if (stream == NULL)
+	{
+		return -1;
+	}
+	rmutexLock(&stream->lock);
+	queued = stream->queueBytes;
+	rmutexUnlock(&stream->lock);
+	return queued;
+}
+
+bool SDL_ClearAudioStream(SDL_AudioStream *stream)
+{
+	if (stream == NULL)
+	{
+		return false;
+	}
+	rmutexLock(&stream->lock);
+	stream->queueHead = 0;
+	stream->queueBytes = 0;
+	rmutexUnlock(&stream->lock);
+	return true;
+}
+
+bool SDL_PauseAudioStreamDevice(SDL_AudioStream *stream)
+{
+	if (stream == NULL)
+	{
+		return false;
+	}
+	rmutexLock(&stream->lock);
+	stream->paused = true;
+	rmutexUnlock(&stream->lock);
+	return true;
+}
+
+bool SDL_ResumeAudioStreamDevice(SDL_AudioStream *stream)
+{
+	if (stream == NULL)
+	{
+		return false;
+	}
+	rmutexLock(&stream->lock);
+	stream->paused = false;
+	rmutexUnlock(&stream->lock);
+	return true;
+}
