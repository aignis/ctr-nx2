+
+SDL_GLContext SDL_GL_CreateContext(SDL_Window *window)
+{
+	const bool es = s_glAttributes[SDL_GL_CONTEXT_PROFILE_MASK] == SDL_GL_CONTEXT_PROFILE_ES;
+	EGLint configCount = 0;
+	EGLint configAttributes[32];
+	EGLint contextAttributes[16];
+	int n = 0;
+	SDL_GLContext context;
+
+	Switch2_DefaultGLAttributes();
+	if (window == NULL)
+	{
+		SDL_SetError("no window");
+		return NULL;
+	}
+
+	if (window->display == EGL_NO_DISPLAY)
+	{
+		window->display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+		if ((window->display == EGL_NO_DISPLAY) || !eglInitialize(window->display, NULL, NULL))
+		{
+			SDL_SetError("eglInitialize failed: 0x%x", eglGetError());
+			window->display = EGL_NO_DISPLAY;
+			return NULL;
+		}
+	}
+	if (!eglBindAPI(es ? EGL_OPENGL_ES_API : EGL_OPENGL_API))
+	{
+		SDL_SetError("eglBindAPI failed: 0x%x", eglGetError());
+		return NULL;
+	}
+
+	if (window->surface == EGL_NO_SURFACE)
+	{
+		configAttributes[n++] = EGL_RENDERABLE_TYPE;
+		configAttributes[n++] = es ? EGL_OPENGL_ES3_BIT : EGL_OPENGL_BIT;
+		configAttributes[n++] = EGL_RED_SIZE;
+		configAttributes[n++] = s_glAttributes[SDL_GL_RED_SIZE];
+		configAttributes[n++] = EGL_GREEN_SIZE;
+		configAttributes[n++] = s_glAttributes[SDL_GL_GREEN_SIZE];
+		configAttributes[n++] = EGL_BLUE_SIZE;
+		configAttributes[n++] = s_glAttributes[SDL_GL_BLUE_SIZE];
+		configAttributes[n++] = EGL_ALPHA_SIZE;
+		configAttributes[n++] = s_glAttributes[SDL_GL_ALPHA_SIZE];
+		configAttributes[n++] = EGL_DEPTH_SIZE;
+		configAttributes[n++] = s_glAttributes[SDL_GL_DEPTH_SIZE];
+		configAttributes[n++] = EGL_STENCIL_SIZE;
+		configAttributes[n++] = s_glAttributes[SDL_GL_STENCIL_SIZE];
+		configAttributes[n++] = EGL_NONE;
+
+		if (!eglChooseConfig(window->display, configAttributes, &window->config, 1, &configCount) || (configCount == 0))
+		{
+			SDL_SetError("eglChooseConfig failed: 0x%x", eglGetError());
+			return NULL;
+		}
+		window->surface = eglCreateWindowSurface(window->display, window->config, (EGLNativeWindowType)nwindowGetDefault(), NULL);
+		if (window->surface == EGL_NO_SURFACE)
+		{
+			SDL_SetError("eglCreateWindowSurface failed: 0x%x", eglGetError());
+			return NULL;
+		}
+	}
+
+	n = 0;
+	contextAttributes[n++] = EGL_CONTEXT_MAJOR_VERSION;
+	contextAttributes[n++] = s_glAttributes[SDL_GL_CONTEXT_MAJOR_VERSION];
+	contextAttributes[n++] = EGL_CONTEXT_MINOR_VERSION;
+	contextAttributes[n++] = s_glAttributes[SDL_GL_CONTEXT_MINOR_VERSION];
+	if (!es)
+	{
+		contextAttributes[n++] = EGL_CONTEXT_OPENGL_PROFILE_MASK;
+		contextAttributes[n++] = (s_glAttributes[SDL_GL_CONTEXT_PROFILE_MASK] == SDL_GL_CONTEXT_PROFILE_COMPATIBILITY)
+		                             ? EGL_CONTEXT_OPENGL_COMPATIBILITY_PROFILE_BIT
+		                             : EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT;
+	}
+	contextAttributes[n++] = EGL_NONE;
+
+	context = (SDL_GLContext)calloc(1, sizeof(*context));
+	if (context == NULL)
+	{
+		SDL_SetError("out of memory");
+		return NULL;
+	}
+	context->context = eglCreateContext(window->display, window->config, EGL_NO_CONTEXT, contextAttributes);
+	if (context->context == EGL_NO_CONTEXT)
+	{
+		SDL_SetError("eglCreateContext %s %d.%d failed: 0x%x", es ? "ES" : "GL", s_glAttributes[SDL_GL_CONTEXT_MAJOR_VERSION],
+		             s_glAttributes[SDL_GL_CONTEXT_MINOR_VERSION], eglGetError());
+		free(context);
+		return NULL;
+	}
+	if (!eglMakeCurrent(window->display, window->surface, window->surface, context->context))
+	{
+		SDL_SetError("eglMakeCurrent failed: 0x%x", eglGetError());
+		eglDestroyContext(window->display, context->context);
+		free(context);
+		return NULL;
+	}
+	s_currentContext = context;
+	printf("[Switch2] GL_RENDERER=%s GL_VERSION=%s\n", (const char *)glGetString(GL_RENDERER), (const char *)glGetString(GL_VERSION));
+	return context;
+}
+
+bool SDL_GL_MakeCurrent(SDL_Window *window, SDL_GLContext context)
+{
+	if ((window == NULL) || (window->display == EGL_NO_DISPLAY))
+	{
+		return SDL_SetError("no window");
+	}
+	if (context == NULL)
+	{
+		eglMakeCurrent(window->display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+		s_currentContext = NULL;
+		return true;
+	}
+	if (!eglMakeCurrent(window->display, window->surface, window->surface, context->context))
+	{
+		return SDL_SetError("eglMakeCurrent failed: 0x%x", eglGetError());
+	}
+	s_currentContext = context;
+	return true;
+}
+
+SDL_GLContext SDL_GL_GetCurrentContext(void)
+{
+	return s_currentContext;
+}
+
+bool SDL_GL_DestroyContext(SDL_GLContext context)
+{
+	if (context == NULL)
+	{
+		return true;
+	}
+	if ((s_window != NULL) && (s_window->display != EGL_NO_DISPLAY))
+	{
+		if (s_currentContext == context)
+		{
+			eglMakeCurrent(s_window->display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+			s_currentContext = NULL;
+		}
+		eglDestroyContext(s_window->display, context->context);
+	}
+	free(context);
+	return true;
+}
