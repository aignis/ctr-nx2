+// ---------------------------------------------------------------------------
+// Filesystem
+
+extern char **__system_argv __attribute__((weak));
+extern int __system_argc __attribute__((weak));
+
+#ifndef CTR_SWITCH2_DEFAULT_BASE
+#define CTR_SWITCH2_DEFAULT_BASE "sdmc:/switch/ctr-native/"
+#endif
+
+static char s_basePath[512];
+
+const char *SDL_GetBasePath(void)
+{
+	if (s_basePath[0] != '\0')
+	{
+		return s_basePath;
+	}
+	snprintf(s_basePath, sizeof(s_basePath), "%s", CTR_SWITCH2_DEFAULT_BASE);
+	// hbmenu passes the NRO path, e.g. sdmc:/switch/ctr-native/ctr-native.nro.
+	if ((&__system_argc != NULL) && (&__system_argv != NULL) && (__system_argv != NULL) && (__system_argc > 0) && (__system_argv[0] != NULL) &&
+	    (strncmp(__system_argv[0], "sdmc:/", 6) == 0))
+	{
+		const char *slash = strrchr(__system_argv[0], '/');
+		size_t len = slash ? (size_t)(slash - __system_argv[0]) + 1 : 0;
+		if ((len > 0) && (len < sizeof(s_basePath)))
+		{
+			memcpy(s_basePath, __system_argv[0], len);
+			s_basePath[len] = '\0';
+		}
+	}
+	return s_basePath;
+}
+
+char *SDL_GetPrefPath(const char *org, const char *app)
+{
+	char path[600];
+	(void)org;
+	(void)app;
+	snprintf(path, sizeof(path), "%s", SDL_GetBasePath());
+	return strdup(path);
+}
+
+const char *SDL_GetUserFolder(SDL_Folder folder)
+{
+	(void)folder;
+	return SDL_GetBasePath();
+}
+
+bool SDL_CreateDirectory(const char *path)
+{
+	if ((path == NULL) || (path[0] == '\0'))
+	{
+		return SDL_SetError("invalid path");
+	}
+	if ((mkdir(path, 0777) == 0) || (errno == EEXIST))
+	{
+		return true;
+	}
+	return SDL_SetError("mkdir %s failed: %s", path, strerror(errno));
+}
