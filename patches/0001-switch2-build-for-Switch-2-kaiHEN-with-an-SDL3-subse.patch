+// ---------------------------------------------------------------------------
+// Audio: one stream, pulled by a thread that feeds audren wave buffers.
+
+#define SWITCH2_AUDIO_BUFFERS       4
+#define SWITCH2_AUDIO_BUFFER_FRAMES 1024
+#define SWITCH2_AUDIO_QUEUE_BYTES   (64 * 1024)
+
+struct SDL_AudioStream
+{
+	SDL_AudioSpec spec;
+	SDL_AudioStreamCallback callback;
+	void *userdata;
+	RMutex lock;
+	u8 *queue;
+	int queueHead;
+	int queueBytes;
+	volatile bool paused;
+	volatile bool running;
+	Thread thread;
+	bool threadStarted;
+	AudioDriver driver;
+	bool audrenReady;
+	bool driverReady;
+	void *pool;
+	size_t poolSize;
+	AudioDriverWaveBuf waveBufs[SWITCH2_AUDIO_BUFFERS];
+	int frameBytes;
+};
+
+static const AudioRendererConfig s_audioConfig = {
+	.output_rate = AudioRendererOutputRate_48kHz,
+	.num_voices = 2,
+	.num_effects = 0,
+	.num_sinks = 1,
+	.num_mix_objs = 1,
+	.num_mix_buffers = 2,
+};
+
+static int Switch2_AudioTake(SDL_AudioStream *stream, u8 *dst, int bytes)
+{
+	int taken = 0;
+	while ((taken < bytes) && (stream->queueBytes > 0))
+	{
+		int chunk = SWITCH2_AUDIO_QUEUE_BYTES - stream->queueHead;
+		if (chunk > stream->queueBytes)
+		{
+			chunk = stream->queueBytes;
+		}
+		if (chunk > bytes - taken)
+		{
+			chunk = bytes - taken;
+		}
+		memcpy(dst + taken, stream->queue + stream->queueHead, (size_t)chunk);
+		stream->queueHead = (stream->queueHead + chunk) % SWITCH2_AUDIO_QUEUE_BYTES;
+		stream->queueBytes -= chunk;
+		taken += chunk;
+	}
+	return taken;
+}
+
+static void Switch2_AudioFill(SDL_AudioStream *stream, u8 *dst, int bytes)
+{
+	int got = 0;
+	rmutexLock(&stream->lock);
+	if (!stream->paused && (stream->callback != NULL))
+	{
+		int guard = 8;
+		while ((stream->queueBytes < bytes) && (guard-- > 0))
+		{
+			const int before = stream->queueBytes;
+			stream->callback(stream->userdata, stream, bytes - stream->queueBytes, bytes);
+			if (stream->queueBytes == before)
+			{
+				break;
+			}
+		}
+	}
+	if (!stream->paused)
+	{
+		got = Switch2_AudioTake(stream, dst, bytes);
+	}
+	rmutexUnlock(&stream->lock);
+	if (got < bytes)
+	{
+		memset(dst + got, 0, (size_t)(bytes - got));
+	}
+}
+
+static void Switch2_AudioThread(void *arg)
+{
+	SDL_AudioStream *stream = (SDL_AudioStream *)arg;
+	const int bufferBytes = SWITCH2_AUDIO_BUFFER_FRAMES * stream->frameBytes;
+	bool started = false;
+
+	while (stream->running)
+	{
+		for (int i = 0; i < SWITCH2_AUDIO_BUFFERS; i++)
+		{
+			AudioDriverWaveBuf *wb = &stream->waveBufs[i];
+			if ((wb->state == AudioDriverWaveBufState_Free) || (wb->state == AudioDriverWaveBufState_Done))
+			{
+				u8 *data = (u8 *)stream->pool + (size_t)i * (size_t)bufferBytes;
+				Switch2_AudioFill(stream, data, bufferBytes);
+				armDCacheFlush(data, (size_t)bufferBytes);
+				audrvVoiceAddWaveBuf(&stream->driver, 0, wb);
+			}
+		}
+		if (!started || !audrvVoiceIsPlaying(&stream->driver, 0))
+		{
+			audrvVoiceStart(&stream->driver, 0);
+			started = true;
+		}
+		audrvUpdate(&stream->driver);
+		audrenWaitFrame();
+	}
+}
+
+static void Switch2_AudioClose(SDL_AudioStream *stream)
+{
+	if (stream->threadStarted)
+	{
+		stream->running = false;
+		threadWaitForExit(&stream->thread);
+		threadClose(&stream->thread);
+		stream->threadStarted = false;
+	}
+	if (stream->driverReady)
+	{
+		audrvVoiceStop(&stream->driver, 0);
+		audrvUpdate(&stream->driver);
+		audrvClose(&stream->driver);
+		stream->driverReady = false;
+	}
+	if (stream->audrenReady)
+	{
+		audrenExit();
+		stream->audrenReady = false;
+	}
+	free(stream->pool);
+	stream->pool = NULL;
+	free(stream->queue);
+	stream->queue = NULL;
+}
+
+SDL_AudioStream *SDL_OpenAudioDeviceStream(SDL_AudioDeviceID devid, const SDL_AudioSpec *spec, SDL_AudioStreamCallback callback, void *userdata)
+{
+	static const u8 sinkChannels[2] = {0, 1};
+	SDL_AudioStream *stream;
+	Result rc;
+	int bufferBytes;
+	int mempool;
+
+	(void)devid;
+	if ((spec == NULL) || (spec->format != SDL_AUDIO_S16) || (spec->channels < 1) || (spec->channels > 2) || (spec->freq <= 0))
+	{
+		SDL_SetError("unsupported audio format");
+		return NULL;
+	}
+
+	stream = (SDL_AudioStream *)calloc(1, sizeof(*stream));
+	if (stream == NULL)
+	{
+		SDL_SetError("out of memory");
+		return NULL;
+	}
+	stream->spec = *spec;
+	stream->callback = callback;
+	stream->userdata = userdata;
+	stream->paused = true; // SDL3 opens device streams paused
+	stream->frameBytes = (int)sizeof(s16) * spec->channels;
+	rmutexInit(&stream->lock);
+	stream->queue = (u8 *)malloc(SWITCH2_AUDIO_QUEUE_BYTES);
+
+	bufferBytes = SWITCH2_AUDIO_BUFFER_FRAMES * stream->frameBytes;
+	stream->poolSize = ((size_t)bufferBytes * SWITCH2_AUDIO_BUFFERS + (AUDREN_MEMPOOL_ALIGNMENT - 1)) & ~(size_t)(AUDREN_MEMPOOL_ALIGNMENT - 1);
+	stream->pool = memalign(AUDREN_MEMPOOL_ALIGNMENT, stream->poolSize);
+	if ((stream->queue == NULL) || (stream->pool == NULL))
+	{
+		SDL_SetError("out of memory");
+		Switch2_AudioClose(stream);
+		free(stream);
+		return NULL;
+	}
+	memset(stream->pool, 0, stream->poolSize);
+	armDCacheFlush(stream->pool, stream->poolSize);
+
+	rc = audrenInitialize(&s_audioConfig);
+	if (R_FAILED(rc))
+	{
+		SDL_SetError("audrenInitialize failed: 0x%x", rc);
+		Switch2_AudioClose(stream);
+		free(stream);
+		return NULL;
+	}
+	stream->audrenReady = true;
+
+	rc = audrvCreate(&stream->driver, &s_audioConfig, 2);
+	if (R_FAILED(rc))
+	{
+		SDL_SetError("audrvCreate failed: 0x%x", rc);
+		Switch2_AudioClose(stream);
+		free(stream);
+		return NULL;
+	}
+	stream->driverReady = true;
+
+	mempool = audrvMemPoolAdd(&stream->driver, stream->pool, stream->poolSize);
+	audrvMemPoolAttach(&stream->driver, mempool);
+	audrvDeviceSinkAdd(&stream->driver, AUDREN_DEFAULT_DEVICE_NAME, 2, sinkChannels);
+	rc = audrvUpdate(&stream->driver);
+	if (R_SUCCEEDED(rc))
+	{
+		rc = audrenStartAudioRenderer();
+	}
+	if (R_FAILED(rc) || !audrvVoiceInit(&stream->driver, 0, spec->channels, PcmFormat_Int16, spec->freq))
+	{
+		SDL_SetError("audio renderer start failed: 0x%x", rc);
+		Switch2_AudioClose(stream);
+		free(stream);
+		return NULL;
+	}
+	audrvVoiceSetDestinationMix(&stream->driver, 0, AUDREN_FINAL_MIX_ID);
+	if (spec->channels == 2)
+	{
+		audrvVoiceSetMixFactor(&stream->driver, 0, 1.0f, 0, 0);
+		audrvVoiceSetMixFactor(&stream->driver, 0, 0.0f, 0, 1);
+		audrvVoiceSetMixFactor(&stream->driver, 0, 0.0f, 1, 0);
+		audrvVoiceSetMixFactor(&stream->driver, 0, 1.0f, 1, 1);
+	}
+	else
+	{
+		audrvVoiceSetMixFactor(&stream->driver, 0, 1.0f, 0, 0);
+		audrvVoiceSetMixFactor(&stream->driver, 0, 1.0f, 0, 1);
+	}
+
+	for (int i = 0; i < SWITCH2_AUDIO_BUFFERS; i++)
+	{
+		AudioDriverWaveBuf *wb = &stream->waveBufs[i];
+		// One wave buffer per 4 KiB slice of the pool; offsets are in frames.
+		wb->data_raw = (u8 *)stream->pool + (size_t)i * (size_t)bufferBytes;
+		wb->size = (u64)bufferBytes;
+		wb->start_sample_offset = 0;
+		wb->end_sample_offset = SWITCH2_AUDIO_BUFFER_FRAMES;
+		wb->state = AudioDriverWaveBufState_Free;
+	}
+
+	stream->running = true;
+	// Core 2 keeps mixing away from the game thread (core 0 by default).
+	rc = threadCreate(&stream->thread, Switch2_AudioThread, stream, NULL, 0x10000, 0x2B, 2);
+	if (R_SUCCEEDED(rc))
+	{
+		rc = threadStart(&stream->thread);
+		if (R_FAILED(rc))
+		{
+			threadClose(&stream->thread);
+		}
+	}
+	if (R_FAILED(rc))
+	{
+		SDL_SetError("audio thread failed: 0x%x", rc);
+		stream->running = false;
+		Switch2_AudioClose(stream);
+		free(stream);
+		return NULL;
+	}
+	stream->threadStarted = true;
+	return stream;
+}
