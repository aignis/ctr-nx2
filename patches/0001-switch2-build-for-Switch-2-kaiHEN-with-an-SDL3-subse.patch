--- /dev/null
+++ b/platform/switch2/sdl3_switch2.c
@@ -0,0 +1,1580 @@
+// SPDX-License-Identifier: Zlib
+//
+// The subset of SDL3 that CTR Native uses, implemented on libounce (libnx for
+// Switch 2) and OunceVK's EGL. SDL3 has no Switch platform; rather than port a
+// whole SDL backend, this file implements exactly the calls the game's
+// platform layer makes, with SDL3's own headers (externals/SDL/include) for
+// the types, enums and scancode values, so the callers compile unchanged.
+//
+// Video:  EGL on the default NWindow, one fixed-size fullscreen window.
+// Input:  libnx pad, up to four players (player 1 also reads handheld mode).
+// Audio:  audren through libnx's audio driver; the renderer resamples the
+//         game's 44.1 kHz stream to 48 kHz.
+// Events: appletMainLoop (quit), controller connect/disconnect.
+#include <switch.h>
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+
+#include <SDL3/SDL.h>
+
+#include <errno.h>
+#include <malloc.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+// ---------------------------------------------------------------------------
+// Errors, hints, memory, version
+
+static char s_error[256];
+
+bool SDL_SetError(SDL_PRINTF_FORMAT_STRING const char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(s_error, sizeof(s_error), fmt, ap);
+	va_end(ap);
+	return false;
+}
+
+const char *SDL_GetError(void)
+{
+	return s_error;
+}
+
+bool SDL_ClearError(void)
+{
+	s_error[0] = '\0';
+	return true;
+}
+
+#define SWITCH2_MAX_HINTS 32
+static struct
+{
+	char *name;
+	char *value;
+} s_hints[SWITCH2_MAX_HINTS];
+
+bool SDL_SetHint(const char *name, const char *value)
+{
+	int freeSlot = -1;
+	if (name == NULL)
+	{
+		return false;
+	}
+	for (int i = 0; i < SWITCH2_MAX_HINTS; i++)
+	{
+		if (s_hints[i].name == NULL)
+		{
+			if (freeSlot < 0)
+			{
+				freeSlot = i;
+			}
+			continue;
+		}
+		if (strcmp(s_hints[i].name, name) == 0)
+		{
+			free(s_hints[i].value);
+			s_hints[i].value = value ? strdup(value) : NULL;
+			return true;
+		}
+	}
+	if (freeSlot < 0)
+	{
+		return false;
+	}
+	s_hints[freeSlot].name = strdup(name);
+	s_hints[freeSlot].value = value ? strdup(value) : NULL;
+	return true;
+}
+
+const char *SDL_GetHint(const char *name)
+{
+	const char *env;
+	if (name == NULL)
+	{
+		return NULL;
+	}
+	env = getenv(name);
+	if (env != NULL)
+	{
+		return env;
+	}
+	for (int i = 0; i < SWITCH2_MAX_HINTS; i++)
+	{
+		if ((s_hints[i].name != NULL) && (strcmp(s_hints[i].name, name) == 0))
+		{
+			return s_hints[i].value;
+		}
+	}
+	return NULL;
+}
+
+void *SDL_malloc(size_t size)
+{
+	return malloc(size ? size : 1);
+}
+
+void *SDL_calloc(size_t nmemb, size_t size)
+{
+	return calloc(nmemb ? nmemb : 1, size ? size : 1);
+}
+
+void *SDL_realloc(void *mem, size_t size)
+{
+	return realloc(mem, size ? size : 1);
+}
+
+void SDL_free(void *mem)
+{
+	free(mem);
+}
+
+char *SDL_strdup(const char *str)
+{
+	return str ? strdup(str) : NULL;
+}
+
+int SDL_GetVersion(void)
+{
+	return SDL_VERSION;
+}
+
+const char *SDL_GetPlatform(void)
+{
+	return "Nintendo Switch 2";
+}
+
+// ---------------------------------------------------------------------------
+// Time
+
+Uint64 SDL_GetPerformanceCounter(void)
+{
+	return armGetSystemTick();
+}
+
+Uint64 SDL_GetPerformanceFrequency(void)
+{
+	return armGetSystemTickFreq();
+}
+
+Uint64 SDL_GetTicksNS(void)
+{
+	return armTicksToNs(armGetSystemTick());
+}
+
+Uint64 SDL_GetTicks(void)
+{
+	return SDL_GetTicksNS() / 1000000ull;
+}
+
+void SDL_DelayNS(Uint64 ns)
+{
+	svcSleepThread((s64)ns);
+}
+
+void SDL_Delay(Uint32 ms)
+{
+	svcSleepThread((s64)ms * 1000000ll);
+}
+
+void SDL_DelayPrecise(Uint64 ns)
+{
+	const u64 freq = armGetSystemTickFreq();
+	const u64 start = armGetSystemTick();
+	const u64 target = start + armNsToTicks(ns);
+	(void)freq;
+
+	// Horizon's sleep is tick-accurate but may wake up to a scheduler quantum
+	// late; sleep to ~0.5 ms before the target and yield the rest.
+	if (ns > 1000000ull)
+	{
+		svcSleepThread((s64)(ns - 500000ull));
+	}
+	while (armGetSystemTick() < target)
+	{
+		svcSleepThread(0);
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Subsystems and events
+
+static SDL_InitFlags s_initFlags;
+static void Switch2_PadInit(void);
+static void Switch2_PadUpdate(void);
+
+bool SDL_Init(SDL_InitFlags flags)
+{
+	return SDL_InitSubSystem(flags);
+}
+
+bool SDL_InitSubSystem(SDL_InitFlags flags)
+{
+	if (flags & (SDL_INIT_GAMEPAD | SDL_INIT_JOYSTICK))
+	{
+		Switch2_PadInit();
+	}
+	s_initFlags |= flags;
+	return true;
+}
+
+void SDL_QuitSubSystem(SDL_InitFlags flags)
+{
+	s_initFlags &= ~flags;
+}
+
+SDL_InitFlags SDL_WasInit(SDL_InitFlags flags)
+{
+	return flags ? (s_initFlags & flags) : s_initFlags;
+}
+
+void SDL_Quit(void)
+{
+	s_initFlags = 0;
+}
+
+#define SWITCH2_EVENT_QUEUE 64
+static SDL_Event s_events[SWITCH2_EVENT_QUEUE];
+static int s_eventHead;
+static int s_eventCount;
+static bool s_quitSent;
+
+#define SWITCH2_MAX_WATCHES 4
+static struct
+{
+	SDL_EventFilter filter;
+	void *userdata;
+} s_watches[SWITCH2_MAX_WATCHES];
+
+bool SDL_AddEventWatch(SDL_EventFilter filter, void *userdata)
+{
+	for (int i = 0; i < SWITCH2_MAX_WATCHES; i++)
+	{
+		if (s_watches[i].filter == NULL)
+		{
+			s_watches[i].filter = filter;
+			s_watches[i].userdata = userdata;
+			return true;
+		}
+	}
+	return SDL_SetError("too many event watches");
+}
+
+void SDL_RemoveEventWatch(SDL_EventFilter filter, void *userdata)
+{
+	for (int i = 0; i < SWITCH2_MAX_WATCHES; i++)
+	{
+		if ((s_watches[i].filter == filter) && (s_watches[i].userdata == userdata))
+		{
+			s_watches[i].filter = NULL;
+			s_watches[i].userdata = NULL;
+		}
+	}
+}
+
+static void Switch2_PushEvent(const SDL_Event *event)
+{
+	SDL_Event copy = *event;
+	copy.common.timestamp = SDL_GetTicksNS();
+	for (int i = 0; i < SWITCH2_MAX_WATCHES; i++)
+	{
+		if (s_watches[i].filter != NULL)
+		{
+			s_watches[i].filter(s_watches[i].userdata, &copy);
+		}
+	}
+	if (s_eventCount >= SWITCH2_EVENT_QUEUE)
+	{
+		return;
+	}
+	s_events[(s_eventHead + s_eventCount) % SWITCH2_EVENT_QUEUE] = copy;
+	s_eventCount++;
+}
+
+void SDL_PumpEvents(void)
+{
+	if (!appletMainLoop() && !s_quitSent)
+	{
+		SDL_Event quit;
+		memset(&quit, 0, sizeof(quit));
+		quit.type = SDL_EVENT_QUIT;
+		s_quitSent = true;
+		Switch2_PushEvent(&quit);
+	}
+	Switch2_PadUpdate();
+}
+
+bool SDL_PollEvent(SDL_Event *event)
+{
+	if (s_eventCount == 0)
+	{
+		SDL_PumpEvents();
+	}
+	if (s_eventCount == 0)
+	{
+		return false;
+	}
+	if (event != NULL)
+	{
+		*event = s_events[s_eventHead];
+	}
+	s_eventHead = (s_eventHead + 1) % SWITCH2_EVENT_QUEUE;
+	s_eventCount--;
+	return true;
+}
+
+// ---------------------------------------------------------------------------
+// Video: EGL on the default NWindow
+
+struct SDL_Window
+{
+	int width;
+	int height;
+	SDL_WindowFlags flags;
+	EGLDisplay display;
+	EGLSurface surface;
+	EGLConfig config;
+};
+
+struct SDL_GLContextState
+{
+	EGLContext context;
+};
+
+static int s_glAttributes[SDL_GL_EGL_PLATFORM + 1];
+static bool s_glAttributesSet;
+
+static void Switch2_DefaultGLAttributes(void)
+{
+	if (s_glAttributesSet)
+	{
+		return;
+	}
+	s_glAttributesSet = true;
+	s_glAttributes[SDL_GL_RED_SIZE] = 8;
+	s_glAttributes[SDL_GL_GREEN_SIZE] = 8;
+	s_glAttributes[SDL_GL_BLUE_SIZE] = 8;
+	s_glAttributes[SDL_GL_ALPHA_SIZE] = 8;
+	s_glAttributes[SDL_GL_DOUBLEBUFFER] = 1;
+	s_glAttributes[SDL_GL_CONTEXT_MAJOR_VERSION] = 3;
+	s_glAttributes[SDL_GL_CONTEXT_MINOR_VERSION] = 0;
+	s_glAttributes[SDL_GL_CONTEXT_PROFILE_MASK] = SDL_GL_CONTEXT_PROFILE_ES;
+}
+
+bool SDL_GL_SetAttribute(SDL_GLAttr attr, int value)
+{
+	Switch2_DefaultGLAttributes();
+	if (((int)attr < 0) || ((int)attr >= (int)SDL_arraysize(s_glAttributes)))
+	{
+		return SDL_SetError("unsupported GL attribute %d", (int)attr);
+	}
+	s_glAttributes[attr] = value;
+	return true;
+}
+
+bool SDL_GL_GetAttribute(SDL_GLAttr attr, int *value)
+{
+	Switch2_DefaultGLAttributes();
+	if ((value == NULL) || ((int)attr < 0) || ((int)attr >= (int)SDL_arraysize(s_glAttributes)))
+	{
+		return SDL_SetError("unsupported GL attribute");
+	}
+	*value = s_glAttributes[attr];
+	return true;
+}
+
+static SDL_Window *s_window;
+static SDL_GLContext s_currentContext;
+
+#ifndef CTR_SWITCH2_WIDTH
+#define CTR_SWITCH2_WIDTH 1920
+#endif
+#ifndef CTR_SWITCH2_HEIGHT
+#define CTR_SWITCH2_HEIGHT 1080
+#endif
+
+SDL_Window *SDL_CreateWindow(const char *title, int w, int h, SDL_WindowFlags flags)
+{
+	NWindow *nw = nwindowGetDefault();
+	u32 width = CTR_SWITCH2_WIDTH;
+	u32 height = CTR_SWITCH2_HEIGHT;
+	Result rc;
+
+	(void)title;
+	(void)w;
+	(void)h;
+	if (s_window != NULL)
+	{
+		SDL_SetError("only one window is supported");
+		return NULL;
+	}
+
+	// One size for both modes: the game draws into its own internal target
+	// and scales to the window, and a fixed size means no swapchain resize.
+	rc = nwindowSetModeDimensions(nw, width, height, width, height);
+	if (R_FAILED(rc))
+	{
+		fprintf(stderr, "[Switch2] nwindowSetModeDimensions failed: 0x%x\n", rc);
+	}
+	if (R_FAILED(nwindowGetDimensions(nw, &width, &height)) || (width == 0) || (height == 0))
+	{
+		width = CTR_SWITCH2_WIDTH;
+		height = CTR_SWITCH2_HEIGHT;
+	}
+
+	s_window = (SDL_Window *)calloc(1, sizeof(*s_window));
+	if (s_window == NULL)
+	{
+		SDL_SetError("out of memory");
+		return NULL;
+	}
+	s_window->width = (int)width;
+	s_window->height = (int)height;
+	s_window->flags = flags | SDL_WINDOW_FULLSCREEN | SDL_WINDOW_OPENGL | SDL_WINDOW_INPUT_FOCUS | SDL_WINDOW_MOUSE_FOCUS;
+	s_window->flags &= ~(SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIDDEN);
+	s_window->display = EGL_NO_DISPLAY;
+	s_window->surface = EGL_NO_SURFACE;
+	printf("[Switch2] window %ux%u\n", width, height);
+	return s_window;
+}
+
+void SDL_DestroyWindow(SDL_Window *window)
+{
+	if ((window == NULL) || (window != s_window))
+	{
+		return;
+	}
+	if (window->display != EGL_NO_DISPLAY)
+	{
+		eglMakeCurrent(window->display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+		if (window->surface != EGL_NO_SURFACE)
+		{
+			eglDestroySurface(window->display, window->surface);
+		}
+		eglTerminate(window->display);
+	}
+	free(window);
+	s_window = NULL;
+	s_currentContext = NULL;
+}
+
+bool SDL_SetWindowTitle(SDL_Window *window, const char *title)
+{
+	(void)window;
+	(void)title;
+	return true;
+}
