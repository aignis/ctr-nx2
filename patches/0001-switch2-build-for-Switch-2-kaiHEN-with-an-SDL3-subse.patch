+SDL_JoystickID *SDL_GetGamepads(int *count)
+{
+	SDL_JoystickID *ids = (SDL_JoystickID *)calloc(SWITCH2_MAX_PADS + 1, sizeof(SDL_JoystickID));
+	int n = 0;
+	Switch2_PadInit();
+	if (ids != NULL)
+	{
+		for (int i = 0; i < SWITCH2_MAX_PADS; i++)
+		{
+			if (s_padConnected[i])
+			{
+				ids[n++] = (SDL_JoystickID)(i + 1);
+			}
+		}
+	}
+	if (count)
+	{
+		*count = n;
+	}
+	return ids;
+}
