@@ -369,6 +369,120 @@ struct NativeLaunchOptions
 
 // Returns 1 when a complete NTSC-U asset source is selected, 0 when the
 // selected source is missing or invalid, and -1 for a storage/path failure.
+#if defined(CTR_NATIVE_SWITCH2)
+// ctr-native.ini next to the NRO: key=value lines, written with the defaults
+// on first start. Unknown keys are ignored.
+global_variable int s_switch2InternalScale = 3;
+
+static void Switch2Config_Set(const char *key, const char *value)
+{
+	const int number = atoi(value);
+	if (strcmp(key, "widescreen") == 0)
+	{
+		g_cfg_widescreen = number != 0;
+	}
+	else if (strcmp(key, "internal_scale") == 0)
+	{
+		s_switch2InternalScale = (number < 1) ? 1 : ((number > 4) ? 4 : number);
+	}
+	else if (strcmp(key, "bilinear") == 0)
+	{
+		g_cfg_bilinearFiltering = number != 0;
+	}
+	else if (strcmp(key, "voices") == 0)
+	{
+		if (!NativeAssets_SetXAVoiceLanguage(value))
+		{
+			fprintf(stderr, "[Switch2] unknown voices=%s (ENG, SPN, FRN, GRM, ITL, DCH)\n", value);
+		}
+	}
+	else if (strcmp(key, "unlock_all") == 0)
+	{
+		g_cfg_unlockAll = number != 0;
+	}
+}
+
+static void Switch2Config_Load(const char *basePath)
+{
+	char path[1024];
+	char line[256];
+	FILE *file;
+
+	// Defaults: what ctr-web plays with (PAL data in Spanish, 16:9).
+	g_cfg_widescreen = 1;
+	g_cfg_unlockAll = 0;
+	NativeAssets_SetXAVoiceLanguage("SPN");
+
+	snprintf(path, sizeof(path), "%sctr-native.ini", basePath ? basePath : "");
+	file = fopen(path, "r");
+	if (file == NULL)
+	{
+		file = fopen(path, "w");
+		if (file != NULL)
+		{
+			fputs("# CTR Native para Switch 2. Cambia los valores y vuelve a abrir el juego.\n"
+			      "# widescreen: 1 = 16:9, 0 = 4:3\n"
+			      "widescreen=1\n"
+			      "# internal_scale: resolucion interna 1-4 (x 240 lineas)\n"
+			      "internal_scale=3\n"
+			      "# bilinear: 1 = texturas filtradas\n"
+			      "bilinear=0\n"
+			      "# voices: carpeta de voces XA (ENG, SPN, FRN, GRM, ITL, DCH)\n"
+			      "voices=SPN\n"
+			      "# unlock_all: 1 = todo desbloqueado en el menu\n"
+			      "unlock_all=0\n",
+			      file);
+			fclose(file);
+		}
+		printf("[Switch2] wrote default %s\n", path);
+		return;
+	}
+	while (fgets(line, sizeof(line), file) != NULL)
+	{
+		char *eq;
+		char *end;
+		char *key = line;
+		while ((*key == ' ') || (*key == '\t'))
+		{
+			key++;
+		}
+		if ((*key == '#') || (*key == ';') || (*key == '\0'))
+		{
+			continue;
+		}
+		eq = strchr(key, '=');
+		if (eq == NULL)
+		{
+			continue;
+		}
+		*eq = '\0';
+		for (end = eq - 1; (end >= key) && ((*end == ' ') || (*end == '\t')); end--)
+		{
+			*end = '\0';
+		}
+		eq++;
+		while ((*eq == ' ') || (*eq == '\t'))
+		{
+			eq++;
+		}
+		for (end = eq + strlen(eq) - 1; (end >= eq) && ((*end == '\n') || (*end == '\r') || (*end == ' ') || (*end == '\t')); end--)
+		{
+			*end = '\0';
+		}
+		Switch2Config_Set(key, eq);
+	}
+	fclose(file);
+	printf("[Switch2] config %s: widescreen=%d internal_scale=%d bilinear=%d voices=%s unlock_all=%d\n", path, g_cfg_widescreen,
+	       s_switch2InternalScale, g_cfg_bilinearFiltering, NativeAssets_GetXAVoiceLanguage(), g_cfg_unlockAll);
+}
+
+static void Switch2Config_ApplyRenderer(void)
+{
+	const int applied = NativeRenderer_SetInternalResolutionScale(s_switch2InternalScale);
+	Platform_Log("[Switch2] internal_scale requested=%d applied=%d widescreen=%d\n", s_switch2InternalScale, applied, g_cfg_widescreen);
+}
+#endif
