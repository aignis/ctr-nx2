+int NativeAssets_SetXAVoiceLanguage(const char *language)
+{
+	for (int i = 0; i < (int)(sizeof(s_nativeAssetsXALanguages) / sizeof(s_nativeAssetsXALanguages[0])); i++)
+	{
+		if ((language != NULL) && (strcmp(language, s_nativeAssetsXALanguages[i]) == 0))
+		{
+			s_nativeAssetsXALanguage = i;
+			snprintf(s_nativeAssetsXNFPath, sizeof(s_nativeAssetsXNFPath), "XA/%s.XNF", language);
+			return 1;
+		}
+	}
+	return 0;
+}
