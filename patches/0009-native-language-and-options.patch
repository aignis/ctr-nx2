+	LOAD_LangFile(sdata->ptrBigfile1, NativeOptions_TextLangSlot());
+#else
 	LOAD_LangFile(sdata->ptrBigfile1, 1);
+#endif
 	GAMEPROG_NewGame_OnBoot();
 	gGT->overlayIndex_null_notUsed = 0;
 
diff --git a/include/platform.h b/include/platform.h
index efa1fc92..0bfcdb4d 100644
--- a/include/platform.h
+++ b/include/platform.h
@@ -46,4 +46,18 @@ extern int g_cfg_widescreen;
 // scrapbook, Medium/Hard), as ctr-web's "desbloquear todo".
 extern int g_cfg_unlockAll;
 
+// Native OPTIONS menu and boot language select (platform/native_options.c).
+struct RectMenu;
+void NativeOptions_PalLanguageProc(struct RectMenu *menu);
+void NativeOptions_InstallStrings(void);
+int NativeOptions_TextLangSlot(void);
+void NativeOptions_MainMenuUpdate(struct RectMenu *mainMenu);
+int NativeOptions_MainMenuChoose(struct RectMenu *mainMenu, short choose);
+int NativeOptions_LanguageFromCode(const char *code);
+const char *NativeOptions_LanguageCode(void);
+void NativeOptions_Configure(const char *language, int askLanguage, int internalScale, int rumble, void (*saveHook)(void));
+int NativeOptions_AskLanguage(void);
+int NativeOptions_InternalScale(void);
+int NativeOptions_Rumble(void);
+
 #endif
diff --git a/main.c b/main.c
index 0d796d38..7ef900a9 100644
--- a/main.c
+++ b/main.c
@@ -93,6 +93,7 @@
 #include "platform/native_state_digest.c"
 #include "platform/native_storage.c"
 #include "platform/native_str.c"
+#include "platform/native_options.c"
 
 #ifndef CC
 #if defined(__GNUC__)
@@ -369,10 +370,15 @@ struct NativeLaunchOptions
 
 // Returns 1 when a complete NTSC-U asset source is selected, 0 when the
 // selected source is missing or invalid, and -1 for a storage/path failure.
-#if defined(CTR_NATIVE_SWITCH2)
-// ctr-native.ini next to the NRO: key=value lines, written with the defaults
+#if defined(CTR_NATIVE)
+// ctr-native.ini next to the executable: key=value lines, written with the defaults
 // on first start. Unknown keys are ignored.
 global_variable int s_switch2InternalScale = 3;
+global_variable int s_switch2Rumble = 40;
+global_variable int s_switch2AskLanguage = 1;
+global_variable char s_switch2Language[8] = "SPN";
+global_variable char s_switch2CaptureSwaps[128];
+global_variable char s_switch2ConfigPath[1024];
 
 static void Switch2Config_Set(const char *key, const char *value)
 {
@@ -396,20 +402,72 @@ static void Switch2Config_Set(const char *key, const char *value)
 			fprintf(stderr, "[Switch2] unknown voices=%s (ENG, SPN, FRN, GRM, ITL, DCH)\n", value);
 		}
 	}
+	else if (strcmp(key, "language") == 0)
+	{
+		if (NativeOptions_LanguageFromCode(value) >= 0)
+		{
+			snprintf(s_switch2Language, sizeof(s_switch2Language), "%s", value);
+		}
+	}
+	else if (strcmp(key, "ask_language") == 0)
+	{
+		s_switch2AskLanguage = number != 0;
+	}
 	else if (strcmp(key, "unlock_all") == 0)
 	{
 		g_cfg_unlockAll = number != 0;
 	}
+	else if (strcmp(key, "rumble") == 0)
+	{
+		s_switch2Rumble = (number < 0) ? 0 : ((number > 100) ? 100 : number);
+	}
 	else if (strcmp(key, "capture_swaps") == 0)
 	{
 		// diagnostics: capture_<n>.bmp next to the NRO at these swap counts
+		snprintf(s_switch2CaptureSwaps, sizeof(s_switch2CaptureSwaps), "%s", value);
 		NativeRenderer_SetCaptureSwaps(value);
 	}
 }
 
+// Rewrites ctr-native.ini with the current values (the OPTIONS menu calls it).
+static void Switch2Config_Save(void)
+{
+	FILE *file = fopen(s_switch2ConfigPath, "w");
+	if (file == NULL)
+	{
+		fprintf(stderr, "[Switch2] cannot write %s\n", s_switch2ConfigPath);
+		return;
+	}
+	fprintf(file,
+	        "# CTR Native para Switch 2. Se cambia desde OPCIONES en el menu principal,\n"
+	        "# o aqui (vuelve a abrir el juego).\n"
+	        "# widescreen: 1 = 16:9, 0 = 4:3\n"
+	        "widescreen=%d\n"
+	        "# internal_scale: resolucion interna 1-4 (x 240 lineas)\n"
+	        "internal_scale=%d\n"
+	        "# bilinear: 1 = texturas filtradas\n"
+	        "bilinear=%d\n"
+	        "# language: idioma de los textos (ENG, FRN, GRM, ITL, SPN, DCH)\n"
+	        "language=%s\n"
+	        "# ask_language: 1 = elegir idioma al arrancar\n"
+	        "ask_language=%d\n"
+	        "# voices: voces XA (las que haya en assets/XA)\n"
+	        "voices=%s\n"
+	        "# rumble: intensidad de la vibracion 0-100 (0 = apagada)\n"
+	        "rumble=%d\n"
+	        "# unlock_all: 1 = todo desbloqueado en el menu\n"
+	        "unlock_all=%d\n",
+	        g_cfg_widescreen, NativeOptions_InternalScale(), g_cfg_bilinearFiltering, NativeOptions_LanguageCode(), NativeOptions_AskLanguage(),
+	        NativeAssets_GetXAVoiceLanguage(), NativeOptions_Rumble(), g_cfg_unlockAll);
+	if (s_switch2CaptureSwaps[0] != '\0')
+	{
+		fprintf(file, "capture_swaps=%s\n", s_switch2CaptureSwaps);
+	}
+	fclose(file);
+}
+
 static void Switch2Config_Load(const char *basePath)
 {
-	char path[1024];
 	char line[256];
 	FILE *file;
 
@@ -418,73 +476,61 @@ static void Switch2Config_Load(const char *basePath)
 	g_cfg_unlockAll = 0;
 	NativeAssets_SetXAVoiceLanguage("SPN");
 
-	snprintf(path, sizeof(path), "%sctr-native.ini", basePath ? basePath : "");
-	file = fopen(path, "r");
-	if (file == NULL)
-	{
-		file = fopen(path, "w");
-		if (file != NULL)
-		{
-			fputs("# CTR Native para Switch 2. Cambia los valores y vuelve a abrir el juego.\n"
-			      "# widescreen: 1 = 16:9, 0 = 4:3\n"
-			      "widescreen=1\n"
-			      "# internal_scale: resolucion interna 1-4 (x 240 lineas)\n"
-			      "internal_scale=3\n"
