diff --git a/game/DecalFont.c b/game/DecalFont.c
index d2a09c98..9f5de190 100644
--- a/game/DecalFont.c
+++ b/game/DecalFont.c
@@ -1,5 +1,11 @@
 #include <common.h>
 
+#if defined(CTR_NATIVE) && !defined(CTR_NATIVE_NTSC_ONLY)
+// Extracted locally from the user's PAL disc by extract-pal.py.
+// Never distribute the original game's tables in the source repository.
+#include <pal_font_tables.h>
+#endif
+
 // NOTE(aalhendi): ASM-verified NTSC-U 926 0x800223f4-0x800224d0.
 int DecalFont_GetLineWidthStrlen(char *character, int len, int fontType)
 {
@@ -63,7 +69,11 @@ int DecalFont_GetLineWidthStrlen(char *character, int len, int fontType)
 #endif
 
 // if normal character
-#if BUILD != EurRetail
+#if defined(CTR_NATIVE) && !defined(CTR_NATIVE_NTSC_ONLY)
+		// 0x03 is the diacritical tilde: it advances no pixels, the next
+		// character is drawn under it (Ñ)
+		if (c > 3)
+#elif BUILD != EurRetail
 		if (c > 2)
 #else
 		if (c > 3)
@@ -97,6 +107,10 @@ int DecalFont_GetLineWidth(char *str, s16 fontType)
 void DecalFont_DrawLineStrlen(char *str, s16 len, int posX, s16 posY, s16 fontType, int flags)
 {
 	struct GameTracker *gGT = sdata->gGT;
+#if defined(CTR_NATIVE)
+	// Undo the extra horizontal stretch applied to the 16:9 UI.
+	const int nativeTextAnchorX = posX;
+#endif
 
 	// text is justified left by default
 	if (flags & (JUSTIFY_CENTER | JUSTIFY_RIGHT))
@@ -124,6 +138,9 @@ void DecalFont_DrawLineStrlen(char *str, s16 len, int posX, s16 posY, s16 fontTy
 
 	for (; *str != 0 && len != 0; str++, len--)
 	{
+#if defined(CTR_NATIVE)
+		POLY_GT4 *nativeTextPoly = (POLY_GT4 *)gGT->backBuffer->primMem.cursor;
+#endif
 		u8 *strcopy = (u8 *)str;
 		u16 iconID = 0xff;
 		s16 charWidth = data.font_charPixWidth[fontType];
@@ -138,6 +155,10 @@ void DecalFont_DrawLineStrlen(char *str, s16 len, int posX, s16 posY, s16 fontTy
 
 #endif
 
+#if defined(CTR_NATIVE) && !defined(CTR_NATIVE_NTSC_ONLY)
+		b32 upsideDownCharacter = false;
+#endif
+
 		u32 *ptrColor = data.ptrColor[flags];
 
 #if BUILD >= JpnTrial
@@ -246,6 +267,34 @@ void DecalFont_DrawLineStrlen(char *str, s16 len, int posX, s16 posY, s16 fontTy
 			pixHeightExtra = data.font_indentPixDimensions[(fontType * 2) + 1];
 		}
 
+#if defined(CTR_NATIVE) && !defined(CTR_NATIVE_NTSC_ONLY)
+		// Same extra glyphs as the PAL build, but with the tables above.
+		// Ñ: the tilde is an underscore shrunk and placed over the next letter.
+		if (*strcopy == 3)
+		{
+			iconID = 0x2f;
+			pixWidthExtra = s_nativeFontEurTilde[fontType * 3];
+			pixHeightExtra = s_nativeFontEurTilde[(fontType * 3) + 1];
+			iconScale = s_nativeFontEurTilde[(fontType * 3) + 2];
+			charWidth = 0;
+		}
+		// ¡ and ¿ are the same glyphs flipped vertically
+		if ((*strcopy == '#') || (*strcopy == '$'))
+		{
+			upsideDownCharacter = true;
+			iconID = (*strcopy == '#') ? 0x25 : 0x2e;
+			pixWidthExtra = s_nativeFontEurInvertedMark[fontType * 2];
+			pixHeightExtra = s_nativeFontEurInvertedMark[(fontType * 2) + 1];
+		}
+		// º (ordinal indicator)
+		if (*strcopy == '&')
+		{
+			iconID = 0x2c;
+			pixWidthExtra = s_nativeFontEurOrdinal[fontType * 2];
+			pixHeightExtra = s_nativeFontEurOrdinal[(fontType * 2) + 1];
+		}
+#endif
+
 #else
 
 		// europe only has 0x60 characters
@@ -452,15 +501,33 @@ void DecalFont_DrawLineStrlen(char *str, s16 len, int posX, s16 posY, s16 fontTy
 
 				if (iconID < gGT->iconGroup[iconGroupID]->numIcons)
 				{
-					DecalHUD_DrawPolyGT4(IconGroup_GetIcon(gGT->iconGroup[iconGroupID], (size_t)iconID, "font icon"),
+#if defined(CTR_NATIVE) && !defined(CTR_NATIVE_NTSC_ONLY)
+					if (upsideDownCharacter)
+					{
+						// ¡ and ¿: same glyphs as ! and ?, rotated 180°
+						DecalHUD_Arrow2D(IconGroup_GetIcon(gGT->iconGroup[iconGroupID], (size_t)iconID, "font icon"),
 
-					                     posX + pixWidthExtra, posY + pixHeightExtra,
+						                 posX + pixWidthExtra, posY + pixHeightExtra,
 
-					                     &gGT->backBuffer->primMem, gGT->pushBuffer_UI.ptrOT,
+						                 &gGT->backBuffer->primMem, gGT->pushBuffer_UI.ptrOT,
 
-					                     ptrColor[0], ptrColor[1], ptrColor[2], ptrColor[3],
+						                 ptrColor[2], ptrColor[3], ptrColor[0], ptrColor[1],
 
-					                     0, iconScale);
+						                 0, iconScale, 0x800);
+					}
+					else
+#endif
+					{
+						DecalHUD_DrawPolyGT4(IconGroup_GetIcon(gGT->iconGroup[iconGroupID], (size_t)iconID, "font icon"),
+
+						                     posX + pixWidthExtra, posY + pixHeightExtra,
+
+						                     &gGT->backBuffer->primMem, gGT->pushBuffer_UI.ptrOT,
+
+						                     ptrColor[0], ptrColor[1], ptrColor[2], ptrColor[3],
+
+						                     0, iconScale);
+					}
 				}
 			}
 
@@ -516,6 +583,15 @@ void DecalFont_DrawLineStrlen(char *str, s16 len, int posX, s16 posY, s16 fontTy
 
 #endif
 		}
+#if defined(CTR_NATIVE)
+		if (g_cfg_widescreen && gGT->backBuffer->primMem.cursor == (void *)(nativeTextPoly + 1))
+		{
+			nativeTextPoly->x0 = nativeTextAnchorX + ((s16)nativeTextPoly->x0 - nativeTextAnchorX) * 3 / 4;
+			nativeTextPoly->x1 = nativeTextAnchorX + ((s16)nativeTextPoly->x1 - nativeTextAnchorX) * 3 / 4;
+			nativeTextPoly->x2 = nativeTextAnchorX + ((s16)nativeTextPoly->x2 - nativeTextAnchorX) * 3 / 4;
+			nativeTextPoly->x3 = nativeTextAnchorX + ((s16)nativeTextPoly->x3 - nativeTextAnchorX) * 3 / 4;
+		}
+#endif
 		posX += charWidth;
 	}
 }
diff --git a/game/LOAD/LOAD_Assets.c b/game/LOAD/LOAD_Assets.c
index 0770d7c5..46aafe47 100644
--- a/game/LOAD/LOAD_Assets.c
+++ b/game/LOAD/LOAD_Assets.c
@@ -246,6 +246,20 @@ struct LngFile
 // It is derived entirely from lngFile, so checkpoint restore rebuilds it.
 static char *s_nativeLanguageStrings[0x1000];
 
+// PAL inserts three controller prompts in its string table. The game code
+// uses NTSC-U indices, so remove those insertions from the pointer table.
+static void LOAD_MapPalLanguageStrings(int numStrings)
+{
+#if defined(CTR_NATIVE_XA_MUSIC_OPTIONAL)
+	if (numStrings < 0x237) return;
+	for (int i = 0x223; i < numStrings - 3; i++)
+	{
+		int shift = (i == 0x223) ? 1 : (i <= 0x228 ? 2 : 3);
+		s_nativeLanguageStrings[i] = s_nativeLanguageStrings[i + shift];
+	}
+#endif
+}
+
 int LOAD_RebuildNativeLanguagePointers(void)
 {
 	struct LngFile *lngFile = sdata->lngFile;
@@ -278,8 +292,10 @@ int LOAD_RebuildNativeLanguagePointers(void)
 		s_nativeLanguageStrings[i] = (char *)((u8 *)lngFile + stringOffset);
 	}
 
+	LOAD_MapPalLanguageStrings(numStrings);
 	sdata->numLngStrings = numStrings;
 	sdata->lngStrings = s_nativeLanguageStrings;
+	NativeOptions_InstallStrings();
 	return 1;
 }
 #endif
@@ -303,10 +319,37 @@ void LOAD_LangFile(struct BigHeader *bigfile, int lang)
 	VSync(0);
 #endif
 
+#if defined(CTR_NATIVE) && (UINTPTR_MAX > UINT32_MAX)
+	// CdRead writes whole 2048-byte sectors, including padding after the LNG.
+	// Reserve enough for every PAL language before the first load: reloading a
+	// larger file into the retail-sized buffer would corrupt the next allocation.
+	if (sdata->lngFile == NULL)
+	{
+		struct BigEntry *entries = BIG_GETENTRY(bigfile);
+		for (int slot = 1; slot <= 7; slot++)
+		{
+			u32 bytes = (u32)entries[BI_LANGUAGEFILE + slot].size;
+			u32 padded = (bytes + LOAD_CD_DATA_SECTOR_ROUND_MASK) & ~LOAD_CD_DATA_SECTOR_ROUND_MASK;
+			if (padded > (u32)sdata->langBufferSize)
+				sdata->langBufferSize = (int)padded;
+		}
+	}
+#endif
 	if (sdata->lngFile == 0)
 	{
 		sdata->lngFile = MEMPACK_AllocMem(sdata->langBufferSize /* "lang buffer" */);
+		if (sdata->lngFile == NULL)
+			return;
+	}
+#if defined(CTR_NATIVE) && (UINTPTR_MAX > UINT32_MAX)
+	{
+		struct BigEntry *entries = BIG_GETENTRY(bigfile);
+		u32 bytes = (u32)entries[BI_LANGUAGEFILE + lang].size;
+		u32 padded = (bytes + LOAD_CD_DATA_SECTOR_ROUND_MASK) & ~LOAD_CD_DATA_SECTOR_ROUND_MASK;
+		if (padded > (u32)sdata->langBufferSize)
+			return;
 	}
+#endif
 
 	lngFile = sdata->lngFile;
 
@@ -350,10 +393,17 @@ void LOAD_LangFile(struct BigHeader *bigfile, int lang)
 	{
 		strArray[i] = (char *)((u8 *)lngFile + CTR_ReadU32LE(&serializedOffsets[i]));
 	}
+#if UINTPTR_MAX > UINT32_MAX
+	LOAD_MapPalLanguageStrings(numStrings);
+#endif
 #if BUILD == EurRetail
 	// set voicelines to new lang
 	CDSYS_SetXAToLang(lang);
 #endif
+#if defined(CTR_NATIVE)
+	// native OPTIONS labels live in spare slots after the language strings
+	NativeOptions_InstallStrings();
+#endif
 }
 
 // NOTE(aalhendi): ASM-verified NTSC-U 926 0x80032c24-0x80032d30.
diff --git a/game/MAIN/MainMain.c b/game/MAIN/MainMain.c
index d3410818..6916da5c 100644
--- a/game/MAIN/MainMain.c
+++ b/game/MAIN/MainMain.c
@@ -644,7 +644,12 @@ void StateZero()
 
 	// English=1
 	// PAL SCES02105 calls it multiple times
+#if defined(CTR_NATIVE) && (UINTPTR_MAX > UINT32_MAX)
