--- /dev/null
+++ b/platform/native_options.c
@@ -0,0 +1,483 @@
+// Native OPTIONS screen in the main menu, plus the PAL-style language select
+// on boot. Both are standalone RectMenus (sdata->ptrDesiredMenu), the same way
+// the PAL build showed its boot language menu, so the game centers them on
+// screen no matter how long the PAL labels are.
+//
+// Labels live in spare slots of the language string table (the LP64 pointer
+// table has room for 0x1000 strings; the PAL language files use 596), so the
+// menu code draws them like any other LNG string. They are rebuilt after every
+// language load and whenever a value changes.
+//
+// Text language: the converted BIGFILE keeps the PAL language files in the
+// NTSC-U slots 2-7 (UK English, French, German, Italian, Spanish, Dutch), so
+// LOAD_LangFile switches language at runtime. Voices: XA/<LANG>.XNF on the SD;
+// only the languages present are offered.
+
+#if defined(CTR_NATIVE) && (UINTPTR_MAX > UINT32_MAX)
+#define NATIVE_OPTIONS_ENABLED 1
+#else
+#define NATIVE_OPTIONS_ENABLED 0
+#endif
+
+#define NATIVE_OPT_LANG_COUNT 6
+#define NATIVE_OPT_LNG_BASE   0xF00
+#define NATIVE_OPT_BOOT_TIMEOUT 900 // 30 s, same as the PAL boot menu
+
+enum NativeOptRow
+{
+	NATIVE_OPT_ROW_SCREEN,
+	NATIVE_OPT_ROW_RESOLUTION,
+	NATIVE_OPT_ROW_FILTER,
+	NATIVE_OPT_ROW_VIBRATION,
+	NATIVE_OPT_ROW_UNLOCK,
+	NATIVE_OPT_ROW_BACK,
+	NATIVE_OPT_ROW_COUNT
+};
+
+enum NativeOptWord
+{
+	NATIVE_OPT_W_SCREEN,
+	NATIVE_OPT_W_RESOLUTION,
+	NATIVE_OPT_W_FILTER,
+	NATIVE_OPT_W_VIBRATION,
+	NATIVE_OPT_W_VOICES,
+	NATIVE_OPT_W_UNLOCK,
+	NATIVE_OPT_W_BACK,
+	NATIVE_OPT_W_ON,
+	NATIVE_OPT_W_OFF,
+	NATIVE_OPT_W_COUNT
+};
+
+// Uppercase without accents, like the PAL language files themselves.
+// Order: English, French, German, Italian, Spanish, Dutch.
+static const char *const s_nativeOptWords[NATIVE_OPT_LANG_COUNT][NATIVE_OPT_W_COUNT] = {
+    {"SCREEN", "RESOLUTION", "TEXTURE FILTER", "VIBRATION", "VOICES", "UNLOCK ALL", "BACK", "ON", "OFF"},
+    {"ECRAN", "RESOLUTION", "FILTRE TEXTURES", "VIBRATION", "VOIX", "TOUT DEBLOQUER", "RETOUR", "OUI", "NON"},
+    {"BILD", "AUFLOESUNG", "TEXTURFILTER", "VIBRATION", "STIMMEN", "ALLES FREISCHALTEN", "ZURUECK", "EIN", "AUS"},
+    {"SCHERMO", "RISOLUZIONE", "FILTRO TEXTURE", "VIBRAZIONE", "VOCI", "SBLOCCA TUTTO", "INDIETRO", "SI", "NO"},
+    {"PANTALLA", "RESOLUCION", "FILTRO TEXTURAS", "VIBRACION", "VOCES", "DESBLOQUEAR TODO", "VOLVER", "SI", "NO"},
+    {"BEELD", "RESOLUTIE", "TEXTUURFILTER", "TRILLING", "STEMMEN", "ALLES VRIJSPELEN", "TERUG", "AAN", "UIT"},
+};
+
+// Same order: NTSC-U language-file slot and XA voice folder.
+static const int s_nativeOptLangSlot[NATIVE_OPT_LANG_COUNT] = {2, 3, 4, 5, 6, 7};
+static const char *const s_nativeOptVoiceCode[NATIVE_OPT_LANG_COUNT] = {"ENG", "FRN", "GRM", "ITL", "SPN", "DCH"};
+
+#if defined(CTR_NATIVE_NTSC_ONLY)
+static int s_nativeOptLang = 0;
+static int s_nativeOptAskLanguage = 0;
+#else
+static int s_nativeOptLang = 4;        // Spanish, ctr-web's default
+static int s_nativeOptAskLanguage = 1; // show the language select on boot
+#endif
+static int s_nativeOptScale = 3;
+static int s_nativeOptRumble = 40; // 0-100
+static int s_nativeOptBootDone;
+static int s_nativeOptConfigured; // NativeOptions_Configure ran (Switch 2 ini)
+static int s_nativeOptBootPending; // language menu opened at boot (timeout)
+static int s_nativeOptBootTimer;
+static int s_nativeOptInputLock; // ignore the tap that opened a menu
+static char s_nativeOptText[NATIVE_OPT_ROW_COUNT][64];
+
+// Set by the platform (Switch 2 writes ctr-native.ini); NULL elsewhere.
+static void (*s_nativeOptSaveHook)(void);
+
+#if NATIVE_OPTIONS_ENABLED
+static void NativeOptions_MenuProc(struct RectMenu *menu);
+
+static struct MenuRow s_nativeOptRows[NATIVE_OPT_ROW_COUNT + 1];
+static struct MenuRow s_nativeOptMainRows[16];
+
+static struct RectMenu s_nativeOptMenu = {
+    .stringIndexTitle = LNG_OPTIONS,
+    .posX_curr = 256,
+    .posY_curr = 120,
+    .state = RECTMENU_STATE_EXEC_CENTERED,
+    .rows = &s_nativeOptRows[0],
+    .funcPtr = NativeOptions_MenuProc,
+};
+
+extern struct RectMenu g_palBootLanguageMenu;
+
+static struct RectMenu *s_nativeOptLangBack; // where the language menu returns
+#endif
+
+int NativeOptions_LanguageFromCode(const char *code)
+{
+	for (int i = 0; i < NATIVE_OPT_LANG_COUNT; i++)
+	{
+		if ((code != NULL) && (strcmp(code, s_nativeOptVoiceCode[i]) == 0))
+		{
+			return i;
+		}
+	}
+	return -1;
+}
+
+const char *NativeOptions_LanguageCode(void)
+{
+	return s_nativeOptVoiceCode[s_nativeOptLang];
+}
+
+void NativeOptions_Configure(const char *language, int askLanguage, int internalScale, int rumble, void (*saveHook)(void))
+{
+	const int lang = NativeOptions_LanguageFromCode(language);
+	if (lang >= 0)
+	{
+		s_nativeOptLang = lang;
+	}
+#if defined(CTR_NATIVE_NTSC_ONLY)
+	// NTSC data has only its own English string table and voices.
+	s_nativeOptLang = 0;
+	askLanguage = 0;
+#endif
+	// Voice language follows text: Spanish for Spanish, English otherwise.
+	NativeAssets_SetXAVoiceLanguage(s_nativeOptLang == 4 ? "SPN" : "ENG");
+	s_nativeOptAskLanguage = askLanguage != 0;
+	s_nativeOptScale = (internalScale < 1) ? 1 : ((internalScale > 4) ? 4 : internalScale);
+	s_nativeOptRumble = (rumble < 0) ? 0 : ((rumble > 100) ? 100 : rumble);
+	s_nativeOptSaveHook = saveHook;
+	s_nativeOptConfigured = 1;
+}
+
+int NativeOptions_AskLanguage(void)
+{
+	return s_nativeOptAskLanguage;
+}
+
+int NativeOptions_InternalScale(void)
+{
+	return s_nativeOptScale;
+}
+
+int NativeOptions_Rumble(void)
+{
+	return s_nativeOptRumble;
+}
+
+// NTSC-U language-file slot for LOAD_LangFile at boot.
+int NativeOptions_TextLangSlot(void)
+{
+#if defined(CTR_NATIVE_NTSC_ONLY)
+	return 1;
+#else
+	return s_nativeOptLangSlot[s_nativeOptLang];
+#endif
+}
+
+static void NativeOptions_ApplyRumble(void)
+{
+#if defined(CTR_NATIVE_SWITCH2)
+	Switch2_SetRumbleStrength(s_nativeOptRumble);
+#endif
+}
+
+// Rebuild the labels in the current language and put them in the string table.
+void NativeOptions_InstallStrings(void)
+{
+#if NATIVE_OPTIONS_ENABLED
+	const char *const *w = s_nativeOptWords[s_nativeOptLang];
+	char **lng = sdata->lngStrings;
+	char value[24];
+
+	// The LP64 pointer table has 0x1000 slots; the PAL files use 596, so the
+	// native labels live past numLngStrings in unused spare slots.
+	if ((lng == NULL) || (sdata->numLngStrings <= 0))
+	{
+		return;
+	}
+
+
+
+	snprintf(s_nativeOptText[NATIVE_OPT_ROW_SCREEN], 64, "%s: %s", w[NATIVE_OPT_W_SCREEN], g_cfg_widescreen ? "16:9" : "4:3");
+	snprintf(s_nativeOptText[NATIVE_OPT_ROW_RESOLUTION], 64, "%s: %dX", w[NATIVE_OPT_W_RESOLUTION], s_nativeOptScale);
+	snprintf(s_nativeOptText[NATIVE_OPT_ROW_FILTER], 64, "%s: %s", w[NATIVE_OPT_W_FILTER],
+	         g_cfg_bilinearFiltering ? w[NATIVE_OPT_W_ON] : w[NATIVE_OPT_W_OFF]);
+	if (s_nativeOptRumble <= 0)
+	{
+		snprintf(value, sizeof(value), "%s", w[NATIVE_OPT_W_OFF]);
+	}
+	else
+	{
+		snprintf(value, sizeof(value), "%d/10", (s_nativeOptRumble + 5) / 10);
+	}
+	snprintf(s_nativeOptText[NATIVE_OPT_ROW_VIBRATION], 64, "%s: %s", w[NATIVE_OPT_W_VIBRATION], value);
+	snprintf(s_nativeOptText[NATIVE_OPT_ROW_UNLOCK], 64, "%s: %s", w[NATIVE_OPT_W_UNLOCK], g_cfg_unlockAll ? w[NATIVE_OPT_W_ON] : w[NATIVE_OPT_W_OFF]);
+	snprintf(s_nativeOptText[NATIVE_OPT_ROW_BACK], 64, "%s", w[NATIVE_OPT_W_BACK]);
+
+	for (int i = 0; i < NATIVE_OPT_ROW_COUNT; i++)
+	{
+		lng[NATIVE_OPT_LNG_BASE + i] = s_nativeOptText[i];
+	}
+#endif
+}
+
+#if NATIVE_OPTIONS_ENABLED
+static void NativeOptions_Save(void)
+{
+	if (s_nativeOptSaveHook != NULL)
+	{
+		s_nativeOptSaveHook();
+	}
+}
+
+static void NativeOptions_InitRows(void)
+{
+	static int done;
+	if (done)
+	{
+		return;
+	}
+	done = 1;
+	for (int i = 0; i < NATIVE_OPT_ROW_COUNT; i++)
+	{
+		struct MenuRow *row = &s_nativeOptRows[i];
+		row->stringIndex = (s16)(NATIVE_OPT_LNG_BASE + i);
+		row->rowOnPressUp = (char)(i > 0 ? i - 1 : 0);
+		row->rowOnPressDown = (char)(i < NATIVE_OPT_ROW_COUNT - 1 ? i + 1 : i);
+		row->rowOnPressLeft = (char)i; // left/right change the value
+		row->rowOnPressRight = (char)i;
+	}
+	s_nativeOptRows[NATIVE_OPT_ROW_COUNT].stringIndex = RECTMENU_STRING_NONE;
+
+
+}
+
+static void NativeOptions_SetLanguage(int lang)
+{
+	if ((lang < 0) || (lang >= NATIVE_OPT_LANG_COUNT))
+	{
+		return;
+	}
+	s_nativeOptLang = lang;
+	LOAD_LangFile(sdata->ptrBigfile1, s_nativeOptLangSlot[lang]); // reinstalls the labels
+	// The packaged voice sets are Spanish and English.
+	NativeAssets_SetXAVoiceLanguage(lang == 4 ? "SPN" : "ENG");
+	NativeOptions_InstallStrings();
+}
+
+// Change the value of an options row; dir is -1 or +1.
+static void NativeOptions_Change(int row, int dir)
+{
+	switch (row)
+	{
+	case NATIVE_OPT_ROW_SCREEN:
+		g_cfg_widescreen = !g_cfg_widescreen;
+		NativeRenderer_SetGameAspect(g_cfg_widescreen);
+		break;
+	case NATIVE_OPT_ROW_RESOLUTION:
+		s_nativeOptScale = ((s_nativeOptScale - 1 + dir + 4) % 4) + 1;
+		s_nativeOptScale = NativeRenderer_SetInternalResolutionScale(s_nativeOptScale);
+		break;
+	case NATIVE_OPT_ROW_FILTER:
+		g_cfg_bilinearFiltering = !g_cfg_bilinearFiltering;
+		break;
+	case NATIVE_OPT_ROW_VIBRATION:
+		s_nativeOptRumble = ((s_nativeOptRumble / 10 + dir + 11) % 11) * 10;
+		NativeOptions_ApplyRumble();
+#if defined(CTR_NATIVE_SWITCH2)
+		Switch2_PreviewRumble();
+#endif
+		break;
+	case NATIVE_OPT_ROW_UNLOCK:
+		g_cfg_unlockAll = !g_cfg_unlockAll;
+		break;
+	default:
+		return;
+	}
+	NativeOptions_InstallStrings();
+	NativeOptions_Save();
+}
+
+static void NativeOptions_OpenMenu(void)
+{
+	NativeOptions_InitRows();
+	NativeOptions_InstallStrings();
+	s_nativeOptMenu.state = RECTMENU_STATE_EXEC_CENTERED;
+	s_nativeOptMenu.rowSelected = 0;
+	s_nativeOptInputLock = 6;
+	s_nativeOptMenu.ptrNextBox_InHierarchy = NULL;
+	sdata->ptrDesiredMenu = &s_nativeOptMenu;
+}
+
+static void NativeOptions_OpenLanguage(struct RectMenu *back, int boot)
+{
+	s_nativeOptLangBack = back;
+	s_nativeOptBootPending = boot;
+	s_nativeOptBootTimer = 0;
+	s_nativeOptInputLock = 6;
+	NativeOptions_InitRows();
+	NativeOptions_InstallStrings();
+	g_palBootLanguageMenu.state = RECTMENU_STATE_EXEC_CENTERED | (boot ? MENU_CANT_GO_BACK : 0);
+	g_palBootLanguageMenu.rowSelected = (s16)s_nativeOptLang;
+	g_palBootLanguageMenu.ptrNextBox_InHierarchy = NULL;
+	sdata->ptrDesiredMenu = &g_palBootLanguageMenu;
+}
+
+static void NativeOptions_CloseLanguage(void)
+{
+	s_nativeOptBootPending = 0;
+	sdata->ptrDesiredMenu = (s_nativeOptLangBack != NULL) ? s_nativeOptLangBack : &D230.menuMainMenu;
+	if (s_nativeOptLangBack == &D230.menuMainMenu)
+	{
+		// boot select: leave the main menu cursor on the first row
+		D230.menuMainMenu.rowSelected = 0;
+	}
+}
+
+static void NativeOptions_MenuProc(struct RectMenu *menu)
+{
+	const s16 row = menu->rowSelected;
+
+	if (menu->funcState == RECTMENU_FUNC_STATE_UPDATE)
+	{
+		const u32 tap = sdata->buttonTapPerPlayer[0];
+		if (s_nativeOptInputLock > 0)
+		{
+			s_nativeOptInputLock--;
+		}
+		// left/right change the highlighted value in place
+		else if ((row >= 0) && (row != NATIVE_OPT_ROW_BACK) && ((tap & (BTN_LEFT | BTN_RIGHT)) != 0))
+		{
+			OtherFX_Play(0, 1);
+			NativeOptions_Change(row, (tap & BTN_LEFT) ? -1 : 1);
+		}
+		return;
+	}
+	if (menu->funcState != RECTMENU_FUNC_STATE_INPUT)
+	{
+		return;
+	}
+	if (s_nativeOptInputLock > 0)
+	{
+		return; // the tap that opened this menu is still held
+	}
+
+	if ((row < 0) || (row == NATIVE_OPT_ROW_BACK))
+	{
+		NativeOptions_Save();
+		sdata->ptrDesiredMenu = &D230.menuMainMenu;
+		return;
+	}
+	// Cross cycles the value (touch/one-button friendliness)
+	NativeOptions_Change(row, 1);
+}
+
+void NativeOptions_PalLanguageProc(struct RectMenu *menu)
+{
+	const s16 row = menu->rowSelected;
+
+	if (menu->funcState == RECTMENU_FUNC_STATE_UPDATE)
+	{
+		if (s_nativeOptInputLock > 0)
+		{
+			s_nativeOptInputLock--;
+		}
+		// PAL boot menu behaviour: keep the configured language after 30 s
+		if (s_nativeOptBootPending && (++s_nativeOptBootTimer >= NATIVE_OPT_BOOT_TIMEOUT))
+		{
+			NativeOptions_SetLanguage(row);
+			NativeOptions_Save();
+			NativeOptions_CloseLanguage();
+		}
+		return;
+	}
+	if (menu->funcState != RECTMENU_FUNC_STATE_INPUT)
+	{
+		return;
+	}
+	if (s_nativeOptInputLock > 0)
+	{
+		return; // the tap that opened this menu is still held
+	}
+
+	s_nativeOptBootPending = 0;
+	if ((row >= 0) && (row < NATIVE_OPT_LANG_COUNT))
+	{
+		NativeOptions_SetLanguage(row);
+		NativeOptions_Save();
+	}
+	else if ((menu->state & MENU_CANT_GO_BACK) != 0)
+	{
+		return; // boot select: a language must be chosen (or the timer runs out)
+	}
+	NativeOptions_CloseLanguage();
+}
+
+// Main menu rows plus OPTIONS at the end.
+static void NativeOptions_BuildMainRows(struct RectMenu *mainMenu)
+{
+	const struct MenuRow *src = mainMenu->rows;
+	int n = 0;
+
+	if (src == s_nativeOptMainRows)
+	{
+		return;
+	}
+	while ((src[n].stringIndex != RECTMENU_STRING_NONE) && (n < (int)len(s_nativeOptMainRows) - 2))
+	{
+		s_nativeOptMainRows[n] = src[n];
+		n++;
+	}
+	if (n == 0)
+	{
+		return;
+	}
+	s_nativeOptMainRows[n - 1].rowOnPressDown = (char)n;
+	s_nativeOptMainRows[n].stringIndex = LNG_OPTIONS;
+	s_nativeOptMainRows[n].rowOnPressUp = (char)(n - 1);
+	s_nativeOptMainRows[n].rowOnPressDown = (char)n;
+	s_nativeOptMainRows[n].rowOnPressLeft = (char)n;
+	s_nativeOptMainRows[n].rowOnPressRight = (char)n;
+	s_nativeOptMainRows[n + 1].stringIndex = RECTMENU_STRING_NONE;
+	mainMenu->rows = s_nativeOptMainRows;
+}
+#endif
+
+// Called at the top of MM_MenuProc_Main every frame.
+void NativeOptions_MainMenuUpdate(struct RectMenu *mainMenu)
+{
+#if NATIVE_OPTIONS_ENABLED
+	NativeOptions_InitRows();
+	if (!s_nativeOptConfigured)
+	{
+		// desktop: no ini, show what the renderer actually uses
+		s_nativeOptConfigured = 1;
+		s_nativeOptScale = s_internalResolutionScale;
+		NativeOptions_InstallStrings();
+	}
+	if ((sdata->lngStrings == NULL) || (sdata->lngStrings[NATIVE_OPT_LNG_BASE] == NULL))
+	{
+		NativeOptions_InstallStrings();
+	}
+	NativeOptions_BuildMainRows(mainMenu);
+
+	// PAL-style language select, once per boot, when the menu is first shown.
+	if (!s_nativeOptBootDone && (mainMenu->funcState == RECTMENU_FUNC_STATE_UPDATE) && (D230.titleMenuState == TITLE_MENU_STATE_IN_MENU) &&
+	    ((mainMenu->state & DRAW_NEXT_MENU_IN_HIERARCHY) == 0))
+	{
+		s_nativeOptBootDone = 1;
+		if (s_nativeOptAskLanguage)
+		{
+			NativeOptions_OpenLanguage(&D230.menuMainMenu, 1);
+		}
+	}
+#endif
+}
+
+// Called from MM_MenuProc_Main with the LNG index of the confirmed row.
+int NativeOptions_MainMenuChoose(struct RectMenu *mainMenu, s16 choose)
+{
+#if NATIVE_OPTIONS_ENABLED
+	(void)mainMenu;
+	if (choose == LNG_OPTIONS)
+	{
+		NativeOptions_OpenMenu();
+		return 1;
+	}
+#else
+	(void)mainMenu;
+	(void)choose;
+#endif
+	return 0;
+}
