diff --git a/game/230/MM_CupSelect.c b/game/230/MM_CupSelect.c
index 66ebc413..ef922a89 100644
--- a/game/230/MM_CupSelect.c
+++ b/game/230/MM_CupSelect.c
@@ -119,9 +119,29 @@ void MM_CupSelect_MenuProc(struct RectMenu *menu)
 		int startX = (s16)D230.transitionMeta_cupSel[cupIndex].currX + (cupIndex & 1) * MM_CUP_SELECT_COLUMN_WIDTH;
 		int startY = (s16)D230.transitionMeta_cupSel[cupIndex].currY + (cupIndex >> 1) * MM_CUP_SELECT_ROW_HEIGHT;
 
+#if defined(CTR_NATIVE)
+		// PAL cup names are much longer than the US ones ("TORNEO DE LA GEMA
+		// AMARILLA"): keep the centred text inside the 512-pixel screen.
+		{
+			char *cupName = sdata->lngStrings[data.ArcadeCups[cupIndex].lngIndex_CupName];
+			const int half = DecalFont_GetLineWidth(cupName, FONT_CREDITS) / 2;
+			int nameX = startX + MM_CUP_SELECT_NAME_X_OFFSET;
+
+			if (nameX + half > 508)
+			{
+				nameX = 508 - half;
+			}
+			if (nameX - half < 4)
+			{
+				nameX = 4 + half;
+			}
+			DecalFont_DrawLine(cupName, nameX, startY + MM_CUP_SELECT_NAME_Y_OFFSET, FONT_CREDITS, txtColor);
+		}
+#else
 		// draw the name of the cup
 		DecalFont_DrawLine(sdata->lngStrings[data.ArcadeCups[cupIndex].lngIndex_CupName], startX + MM_CUP_SELECT_NAME_X_OFFSET,
 		                   startY + MM_CUP_SELECT_NAME_Y_OFFSET, FONT_CREDITS, txtColor);
+#endif
 
 		startX = startX + MM_CUP_SELECT_CONTENT_X_OFFSET;
 		startY = startY + MM_CUP_SELECT_CONTENT_Y_OFFSET;
